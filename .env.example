# Shopify store. Leave both empty to use floki24.ch's live catalogue through
# Shopify's tokenless Storefront API (products, collections, search, cart).
# Without a token, customer accounts and checkout stay local (no payment).
# Set SHOPIFY_STORE_DOMAIN=mock.shop for the offline demo catalogue instead.
#
# To connect your own store with accounts and Shopify's checkout:
# 1. Shopify admin → Settings → Apps and sales channels → Headless → Create storefront
# 2. Copy the *public* Storefront API access token
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shared secret used by /api/revalidate (Shopify webhook → cache invalidation).
SHOPIFY_REVALIDATION_SECRET=

# Public URL of the deployed storefront (sitemap, robots.txt, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
